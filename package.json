{
  "name": "@pkistudio/pkistudiomcp",
  "version": "0.6.0",
  "description": "Local MCP server exposing PkiStudioJS ASN.1 and PKI key material tools.",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/pkistudio/pkistudiomcp.git"
  },
  "bugs": {
    "url": "https://github.com/pkistudio/pkistudiomcp/issues"
  },
  "homepage": "https://github.com/pkistudio/pkistudiomcp#readme",
  "bin": {
    "pkistudiomcp": "dist/index.js",
    "pkistudiomcp-http": "dist/http.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\" && tsc -p tsconfig.json && chmod 755 dist/index.js dist/http.js",
    "check": "npm run build && node --check dist/index.js",
    "smoke": "npm run build && node scripts/smoke-test.mjs",
    "test": "npm run check && node scripts/smoke-test.mjs",
    "prepare": "npm run build",
    "start": "node dist/index.js",
    "dev": "tsx src/index.ts",
    "dev:http": "tsx src/http.ts",
    "start:http": "node dist/http.js"
  },
  "keywords": [
    "asn1",
    "der",
    "ber",
    "pem",
    "pki",
    "mcp",
    "model-context-protocol"
  ],
  "license": "MIT",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@pkistudio/asn1defsifter": "^0.1.3",
    "@pkistudio/asn1instancebuilder": "^0.1.2",
    "@pkistudio/certgadgets": "^0.1.4",
    "@pkistudio/pkistudiojs": "^0.6.1",
    "@pkistudio/pvkgadgets": "^0.4.2",
    "asn1js": "^3.0.10",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^24.12.4",
    "tsx": "^4.22.3",
    "typescript": "^6.0.3"
  },
  "engines": {
    "node": ">=20"
  }
}
