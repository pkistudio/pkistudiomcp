{
  "name": "@pkistudio/pkistudiomcp",
  "version": "0.2.0",
  "description": "Local MCP server exposing PkiStudioJS ASN.1 and PKI key material tools.",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/pkistudio/pkistudiomcp.git"
  },
  "bugs": {
    "url": "https://github.com/pkistudio/pkistudiomcp/issues"
  },
  "homepage": "https://github.com/pkistudio/pkistudiomcp#readme",
  "bin": {
    "pkistudiomcp": "dist/index.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json && chmod 755 dist/index.js",
    "check": "npm run build && node --check dist/index.js",
    "prepare": "npm run build",
    "start": "node dist/index.js",
    "dev": "tsx src/index.ts"
  },
  "keywords": [
    "asn1",
    "der",
    "ber",
    "pem",
    "pki",
    "mcp",
    "model-context-protocol"
  ],
  "license": "MIT",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "asn1js": "^3.0.10",
    "pkijs": "^3.4.0",
    "pkistudiojs": "github:pkistudio/pkistudiojs#v0.2.5",
    "zod": "^4.4.1"
  },
  "devDependencies": {
    "@types/node": "^24.10.1",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3"
  },
  "engines": {
    "node": ">=20"
  }
}
